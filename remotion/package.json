{
  "name": "portfolio-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated Remotion studio that renders the D-Talk case-study demo reel. Not part of the Next.js build — it only produces a static video in ../public.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts DtalkDemo ../public/dtalk-demo.mp4 --codec=h264",
    "render:webm": "remotion render src/index.ts DtalkDemo ../public/dtalk-demo.webm --codec=vp8",
    "still": "remotion still src/index.ts DtalkDemo ../public/dtalk-demo-poster.jpg --frame=120",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.489",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.7.3"
  }
}
